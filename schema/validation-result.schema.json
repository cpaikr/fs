{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs.example/schema/0.1/validation-result.schema.json",
  "title": "FS V0 validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "conformance", "calculations"],
  "properties": {
    "formatVersion": { "const": "0.1" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors"],
      "properties": {
        "status": { "enum": ["conforming", "nonconforming"] },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "$ref": "fs-document.schema.json#/$defs/id" },
              "path": { "type": "string" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "calculations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "applications"],
      "properties": {
        "status": { "enum": ["not-defined", "not-evaluated", "consistent", "inconsistent"] },
        "applications": {
          "type": "array",
          "items": { "$ref": "fs-document.schema.json#/$defs/applicationResult" }
        }
      }
    }
  }
}
