{
  "id": "record-validation-output-exists",
  "command": "fs",
  "arguments": ["record-validation", "--output", "recorded.json", "input.json"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "input.json" },
    { "copy": "../valid/no-calculation-rules.json", "to": "recorded.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message", "path"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "record-validation" },
        { "pointer": "/error/code", "equals": "output-exists" },
        { "pointer": "/error/path", "equals": "recorded.json" },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["record-validation", "--output", "<new-document>", "input.json"] }]
        }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 1,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["input.json", "recorded.json"],
        "absent": []
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
