{
  "id": "record-validation-duplicate-output",
  "command": "fs",
  "arguments": ["record-validation", "--output", "first.json", "--output", "second.json", "input.json"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs record-validation", "document...", "Exactly one", "--output"],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["output"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["input.json"],
        "absent": ["first.json", "second.json"]
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
