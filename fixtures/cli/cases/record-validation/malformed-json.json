{
  "id": "record-validation-malformed-json",
  "command": "fs",
  "arguments": ["record-validation", "--output", "recorded.json", "input.json"],
  "workspace": [
    { "copy": "../raw-input/malformed-json.json.txt", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message", "path"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "record-validation" },
        { "pointer": "/error/code", "equals": "invalid-json" },
        { "pointer": "/error/path", "equals": "input.json" },
        { "pointer": "/help", "equals": [] }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 1,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["input.json"],
        "absent": ["recorded.json"]
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
