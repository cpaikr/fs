{
  "id": "validate-extra-argument",
  "command": "fs",
  "arguments": ["validate", "input.json", "extra.json"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "validate" },
        { "pointer": "/error/code", "equals": "unexpected-argument" },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["validate","input.json","--format","json"] }]
        }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["input.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
