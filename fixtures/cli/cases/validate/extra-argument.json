{
  "id": "validate-extra-argument",
  "command": "fs",
  "arguments": ["validate", "input.json", "extra.json"],
  "workspace": [
    { "copy": "../valid/no-rollups.json", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs validate", "document...", "Exactly one"],
      "excludes": ["--format"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["extra.json"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["input.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
