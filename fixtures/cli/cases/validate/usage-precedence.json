{
  "id": "validate-usage-precedence",
  "command": "fs",
  "arguments": ["validate", "missing.json", "--unknown"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "validate" },
        { "pointer": "/error/code", "equals": "unknown-flag" },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["validate","missing.json","--format","json"] }]
        }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": ["missing.json"] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
