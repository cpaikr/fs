{
  "id": "validate-usage-precedence",
  "command": "fs",
  "arguments": ["validate", "missing.json", "--unknown"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs validate", "document...", "Exactly one"],
      "excludes": ["--format"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["--unknown"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": ["missing.json"] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
