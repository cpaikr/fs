{
  "id": "validate-decimal-digit-limit-exact",
  "command": "fs",
  "arguments": ["validate", "input.json"],
  "workspace": [
    {
      "generated": [
        { "utf8": "{\"formatVersion\":\"0.2\",\"entity\":{\"name\":\"x\"},\"scope\":{\"label\":\"x\"},\"units\":[{\"id\":\"u\",\"label\":\"u\",\"measure\":\"u\",\"scale\":0}],\"periods\":[{\"id\":\"p\",\"kind\":\"instant\",\"date\":\"2025-01-01\"}],\"statements\":[{\"id\":\"s\",\"label\":\"s\",\"periods\":[\"p\"],\"items\":[{\"id\":\"i\",\"label\":\"i\",\"unit\":\"u\",\"values\":{\"p\":\"", "count": 1 },
        { "utf8": "1", "count": 1000 },
        { "utf8": "\"}}]}]}", "count": 1 }
      ],
      "to": "input.json"
    }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [{ "pointer": "", "equals": ["validation", "snapshotDiff", "help"] }],
      "equalities": [
        { "pointer": "/validation", "equalsFile": { "file": "../calculation-results/no-rollups.json" } },
        { "pointer": "/snapshotDiff", "equalsFile": { "file": "../snapshot-diffs/not-recorded.json" } },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["record-validation", "--output", "<new-document>", "input.json"] }]
        }
      ],
      "nonemptyStrings": []
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["input.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
