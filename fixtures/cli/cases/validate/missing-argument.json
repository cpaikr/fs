{
  "id": "validate-missing-argument",
  "command": "fs",
  "arguments": ["validate"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs validate", "document...", "Exactly one"],
      "excludes": ["--format"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["document"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
