{
  "id": "validate-recorded-no-rollups-output",
  "command": "fs",
  "arguments": ["validate", "recorded.json"],
  "workspace": [
    { "copy": "expected/record-validation/no-rollups.json", "to": "recorded.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["validation", "snapshotDiff", "help"] },
        { "pointer": "/snapshotDiff", "equals": ["formatVersion", "status", "conformance", "calculations", "applications"] },
        { "pointer": "/snapshotDiff/conformance", "equals": ["recorded", "current"] },
        { "pointer": "/snapshotDiff/calculations", "equals": ["recorded", "current"] }
      ],
      "arrays": [{ "pointer": "/snapshotDiff/applications", "equals": 0 }],
      "equalities": [
        { "pointer": "/validation", "equalsFile": { "file": "../calculation-results/no-rollups.json" } },
        { "pointer": "/snapshotDiff/formatVersion", "equals": "0.2" },
        { "pointer": "/snapshotDiff/status", "equals": "match" },
        { "pointer": "/snapshotDiff/conformance/recorded", "equals": "conforming" },
        { "pointer": "/snapshotDiff/conformance/current", "equals": "conforming" },
        { "pointer": "/snapshotDiff/calculations/recorded", "equals": "not-defined" },
        { "pointer": "/snapshotDiff/calculations/current", "equals": "not-defined" },
        { "pointer": "/help", "equals": [] }
      ],
      "nonemptyStrings": []
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["recorded.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
