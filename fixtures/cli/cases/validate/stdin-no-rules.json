            "file": "../snapshot-diffs/not-recorded.json"
          }
        },
        {
          "pointer": "/help",
          "equals": []
        }
      ],
      "nonemptyStrings": []
    },
    "stderr": {
      "encoding": "bytes",
      "equalsUtf8": ""
    },
    "exitCode": 0,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": [],
        "absent": []
      },
      "home": {
        "created": [],
        "unchanged": [],
        "absent": []
      }
    }
  }
