{
  "id": "validate-stdin-no-rules",
  "command": "fs",
  "arguments": ["validate", "-"],
  "workspace": [],
  "stdin": {
    "file": "../valid/no-calculation-rules.json"
  },
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        {
          "pointer": "",
          "equals": ["validation", "snapshotDiff", "help"]
        }
      ],
      "equalities": [
        {
          "pointer": "/validation",
          "equalsFile": {
            "file": "../calculation-results/no-rules.json"
