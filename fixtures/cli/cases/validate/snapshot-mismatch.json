{
  "id": "validate-snapshot-mismatch",
  "command": "fs",
  "arguments": ["validate", "input.json"],
  "workspace": [
    {
      "copy": "../valid/snapshot-mismatch-source.json",
      "to": "input.json"
    }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        {
          "pointer": "",
          "equals": ["validation", "snapshotDiff", "help"]
        }
      ],
      "equalities": [
        {
          "pointer": "/validation",
          "equalsFile": {
            "file": "../calculation-results/snapshot-mismatch-current.json"
          }
        },
        {
          "pointer": "/snapshotDiff",
          "equalsFile": {
            "file": "../snapshot-diffs/mismatch.json"
          }
        },
        {
          "pointer": "/help",
          "equals": []
        }
      ],
      "nonemptyStrings": []
    },
    "stderr": {
      "encoding": "bytes",
      "equalsUtf8": ""
    },
    "exitCode": 0,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["input.json"],
        "absent": []
      },
      "home": {
        "created": [],
        "unchanged": [],
        "absent": []
      }
    }
  }
}
