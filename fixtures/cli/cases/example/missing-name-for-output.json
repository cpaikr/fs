{
  "id": "example-missing-name-for-output",
  "command": "fs",
  "arguments": ["example", "--output", "result.json"],
  "workspace": [
    { "copy": "../valid/no-rollups.json", "to": "result.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs example", "name", "minimal", "manufacturing-group", "--output"],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["name"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["result.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
