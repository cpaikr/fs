{
  "id": "example-duplicate-output",
  "command": "fs",
  "arguments": ["example", "--output", "first.json", "--output", "second.json", "minimal"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs example", "name", "--output"],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["output"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": ["first.json", "second.json"] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
