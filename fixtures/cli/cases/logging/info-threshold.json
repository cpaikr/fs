{
  "id": "logging-info-threshold",
  "command": "fs",
  "arguments": ["--log-level", "info", "validate", "input.json"],
  "workspace": [
    { "copy": "../valid/no-rollups.json", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["validation", "snapshotDiff", "help"] }
      ],
      "equalities": [
        {
          "pointer": "/validation",
          "equalsFile": { "file": "../calculation-results/no-rollups.json" }
        },
        {
          "pointer": "/snapshotDiff",
          "equalsFile": { "file": "../snapshot-diffs/not-recorded.json" }
        },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["record-validation", "--output", "<new-document>", "input.json"] }]
        }
      ],
      "nonemptyStrings": []
    },
    "stderr": {
      "encoding": "json-lines",
      "equalsFile": "expected/logs/validate-info.jsonl"
    },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["input.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
