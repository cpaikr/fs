{
  "id": "logging-explicit-none",
  "command": "fs",
  "arguments": ["validate", "input.json", "--log-level", "none"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["validation", "snapshotDiff", "help"] }
      ],
      "equalities": [
        {
          "pointer": "/validation",
          "equalsFile": { "file": "../calculation-results/no-rules.json" }
        },
        {
          "pointer": "/snapshotDiff",
          "equalsFile": { "file": "../snapshot-diffs/not-recorded.json" }
        },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["record-validation","input.json","--output","<new-document>"] }]
        }
      ],
      "nonemptyStrings": []
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["input.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
