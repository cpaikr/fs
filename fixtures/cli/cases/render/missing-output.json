{
  "id": "render-missing-output",
  "command": "fs",
  "arguments": ["render", "input.json"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "input.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs render", "document...", "Exactly one", "--output"],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["--output"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["input.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
