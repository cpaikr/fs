{
  "id": "create-output-missing-parent",
  "command": "fs",
  "arguments": ["create", "--output", "missing/result.json", "candidate.json"],
  "workspace": [
    { "copy": "../raw-input/noncanonical-valid.json", "to": "candidate.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message", "path"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "create" },
        { "pointer": "/error/code", "equals": "output-parent-not-found" },
        { "pointer": "/error/path", "equals": "missing/result.json" },
        {
          "pointer": "/help",
          "equals": [{ "executable": "fs", "arguments": ["create","--output","<new-document>","candidate.json"] }]
        }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 1,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["candidate.json"],
        "absent": ["missing/result.json"]
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
