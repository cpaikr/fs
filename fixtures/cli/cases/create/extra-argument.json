{
  "id": "create-extra-argument",
  "command": "fs",
  "arguments": ["create", "--output", "result.json", "candidate.json", "extra.json"],
  "workspace": [
    { "copy": "../valid/no-rollups.json", "to": "candidate.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs create", "candidate...", "Exactly one", "--output"],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["extra.json"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["candidate.json"],
        "absent": ["result.json"]
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
