{
  "id": "create-missing-candidate",
  "command": "fs",
  "arguments": ["create", "--output", "result.json"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "result.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "create" },
        { "pointer": "/error/code", "equals": "missing-argument" },
        {
          "pointer": "/help",
          "equals": ["fs create <candidate|-> --output <new-document>"]
        }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["result.json"], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
