{
  "id": "create-unknown-flag",
  "command": "fs",
  "arguments": ["create", "--output", "result.json", "missing.json", "--unknown"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "result.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs create", "candidate...", "Exactly one", "--output"],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "native-text", "contains": ["--unknown"], "excludes": [], "ansi": false },
    "exitCode": 2,
    "filesystem": {
      "workspace": {
        "created": [],
        "unchanged": ["result.json"],
        "absent": ["missing.json"]
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
