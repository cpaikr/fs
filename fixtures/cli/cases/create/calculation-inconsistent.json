{
  "id": "create-calculation-inconsistent",
  "command": "fs",
  "arguments": ["create", "candidate.json", "--output", "result.json"],
  "workspace": [
    { "copy": "../../examples/manufacturing-group.json", "to": "candidate.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["validation", "snapshotDiff", "output", "help"] },
        { "pointer": "/output", "equals": ["status", "path"] }
      ],
      "equalities": [
        {
          "pointer": "/validation",
          "equalsFile": { "file": "../calculation-results/manufacturing-group.json" }
        },
        {
          "pointer": "/snapshotDiff",
          "equalsFile": { "file": "../snapshot-diffs/not-recorded.json" }
        },
        { "pointer": "/output/status", "equals": "created" },
        { "pointer": "/output/path", "equals": "result.json" },
        { "pointer": "/help", "equals": [] }
      ],
      "nonemptyStrings": []
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": {
        "created": [
          { "path": "result.json", "equalsFile": "../../examples/manufacturing-group.json" }
        ],
        "unchanged": ["candidate.json"],
        "absent": []
      },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
