  "workingDirectory": "unavailable",
  "arguments": [],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [{ "pointer": "", "equals": ["executable", "package", "input", "artifact", "commands", "help"] }],
      "equalities": [
        { "pointer": "/executable", "equals": "fs" },
