        { "pointer": "/commands", "equalsFile": { "file": "expected/discovery.json", "pointer": "/commands" } },
        { "pointer": "/help", "equalsFile": { "file": "expected/discovery.json", "pointer": "/help" } }
      ],
      "nonemptyStrings": []
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
