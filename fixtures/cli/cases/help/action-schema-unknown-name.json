{
  "id": "help-action-schema-unknown-name",
  "command": "fs",
  "arguments": ["schema", "unknown", "--help"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": ["USAGE", "fs schema", "name...", "Exactly one", "--output", "--help"],
      "excludes": ["--artifact-version", "wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
