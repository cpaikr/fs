{
  "id": "help-reject-invalid-schema-name",
  "command": "fs",
  "arguments": ["schema", "unknown", "--help"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "schema" },
        { "pointer": "/error/code", "equals": "unknown-schema" },
        { "pointer": "/help", "equals": [{ "executable": "fs", "arguments": ["schema", "document", "--version", "0.1"] }] }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
