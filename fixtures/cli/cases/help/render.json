{
  "id": "help-render",
  "command": "fs",
  "arguments": ["render", "--help"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": [
        "USAGE",
        "fs render",
        "document...",
        "Exactly one",
        "--output",
        "--help",
        "--version",
        "--completions",
        "--log-level"
      ],
      "excludes": ["wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
