{
  "id": "help-schema",
  "command": "fs",
  "arguments": ["schema", "--help"],
  "workspace": [],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "native-text",
      "contains": [
        "USAGE",
        "fs schema",
        "name...",
        "Exactly one",
        "document",
        "validation-result",
        "snapshot-diff",
        "--output",
        "--help",
        "--version",
        "--completions",
        "--log-level"
      ],
      "excludes": ["--artifact-version", "wizard", "prompt", "interactive"],
      "ansi": false
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 0,
    "filesystem": {
      "workspace": { "created": [], "unchanged": [], "absent": [] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
