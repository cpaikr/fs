{
  "id": "help-reject-extra-operand",
  "command": "fs",
  "arguments": ["create", "candidate.json", "extra.json", "--output", "result.json", "--help"],
  "workspace": [
    { "copy": "../valid/no-calculation-rules.json", "to": "candidate.json" }
  ],
  "stdin": null,
  "expect": {
    "stdout": {
      "encoding": "json",
      "members": [
        { "pointer": "", "equals": ["error", "help"] },
        { "pointer": "/error", "equals": ["operation", "code", "message"] }
      ],
      "equalities": [
        { "pointer": "/error/operation", "equals": "create" },
        { "pointer": "/error/code", "equals": "unexpected-argument" },
        { "pointer": "/help", "equals": [{ "executable": "fs", "arguments": ["create", "candidate.json", "--output", "<new-document>"] }] }
      ],
      "nonemptyStrings": ["/error/message"]
    },
    "stderr": { "encoding": "bytes", "equalsUtf8": "" },
    "exitCode": 2,
    "filesystem": {
      "workspace": { "created": [], "unchanged": ["candidate.json"], "absent": ["result.json"] },
      "home": { "created": [], "unchanged": [], "absent": [] }
    }
  }
}
