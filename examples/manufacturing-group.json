      "terms": [
        { "coefficient": "1", "item": "liabilities" },
        { "coefficient": "1", "item": "equity" }
      ],
      "scope": { "periods": ["at-2024-12-31", "at-2025-12-31"] }
    },
    {
      "id": "equity-component-rollup",
      "kind": "samePeriod",
      "unit": "krw-millions",
      "target": { "item": "closing-equity" },
      "terms": [
        { "coefficient": "1", "item": "opening-equity" },
        { "coefficient": "1", "item": "owner-contributions" },
        { "coefficient": "1", "item": "equity-profit" },
        { "coefficient": "1", "item": "dividends" }
      ],
