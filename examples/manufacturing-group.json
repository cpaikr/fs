        "periods": ["fy2025"],
        "dimensions": [
          { "equity-component": "share-capital" },
          { "equity-component": "retained-earnings" }
        ]
      }
    },
    {
      "id": "cash-roll-forward",
      "kind": "rollForward",
      "unit": "krw-millions",
      "balance": { "item": "cash" },
      "movements": [
        { "coefficient": "1", "item": "net-cash-movement" }
      ],
      "scope": {
        "periods": ["fy2023", "fy2024", "q4-2024", "fy2025", "q1-2025", "q2-2025", "ytd-h1-2025", "fy2026", "fy2028"]
      }
    },
