        { "coefficient": "1", "item": "direct-materials" },
        { "coefficient": "1", "item": "direct-labor" },
        { "coefficient": "1", "item": "factory-overhead" }
      ],
      "scope": { "periods": ["fy2024", "fy2025"] }
