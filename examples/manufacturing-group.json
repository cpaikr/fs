  "calculationRules": [
    {
      "id": "gross-profit-subtotal",
      "kind": "samePeriod",
      "unit": "krw-millions",
      "target": { "item": "gross-profit" },
      "terms": [
        { "coefficient": "1", "item": "revenue" },
        { "coefficient": "1", "item": "cost-of-sales" }
      ],
      "scope": { "periods": ["fy2024", "fy2025"] }
    },
    {
      "id": "manufacturing-cost-subtotal",
      "kind": "samePeriod",
      "unit": "krw-millions",
      "target": { "item": "manufacturing-cost" },
