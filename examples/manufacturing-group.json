      "id": "net-income-reconciliation",
      "kind": "assertion",
      "target": {
        "item": "net-income-equity",
        "period": "fy2025",
        "unit": "krw-millions"
      },
      "terms": [
        {
          "coefficient": "1",
          "fact": {
            "item": "net-income",
            "period": "fy2025",
            "unit": "krw-millions"
          }
        }
      ]
    }
